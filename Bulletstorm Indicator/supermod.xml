            </group>
            <group :hook_id="hud/hudteammate">
                <post script_path="hudteammate.lua" />
                <post :script_path="MUI.lua" />
				<post :script_path="Holo.lua" />
				<post :script_path="VoidUI.lua" />
            </group>
        </group>
